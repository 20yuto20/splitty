generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  id        String    @id
  name      String
  currency  String    @default("USD")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  members   Member[]
  expenses  Expense[]
}

model Member {
  id        String         @id @default(cuid())
  groupId   String
  name      String
  createdAt DateTime       @default(now())
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidFor   Expense[]      @relation("payer")
  shares    ExpenseShare[]

  @@index([groupId])
}

model Expense {
  id          String         @id @default(cuid())
  groupId     String
  payerId     String
  description String
  amount      Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer       Member         @relation("payer", fields: [payerId], references: [id])
  shares      ExpenseShare[]

  @@index([groupId])
}

model ExpenseShare {
  id        String  @id @default(cuid())
  expenseId String
  memberId  String
  amount    Int
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member    Member  @relation(fields: [memberId], references: [id])

  @@unique([expenseId, memberId])
  @@index([memberId])
}
