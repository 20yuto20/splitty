# PostgreSQL connection string
# For local development:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/splitty?schema=public"
# For Vercel + Vercel Postgres / Neon / Supabase, paste the pooled connection string:
DATABASE_URL="postgresql://user:password@host:5432/splitty?schema=public&sslmode=require"

# Public site URL (used to build shareable group links). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
